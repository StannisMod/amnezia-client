# Deploy the native executable's own dependency closure, independently of the
# service's OpenSSL target. Never modify the cached executable or its libraries.
cmake_minimum_required(VERSION 3.25)
if(NOT IS_ABSOLUTE "${OPENVPN_SOURCE}" OR NOT EXISTS "${OPENVPN_SOURCE}"
        OR NOT IS_ABSOLUTE "${OPENVPN_DESTINATION}")
    message(FATAL_ERROR "OpenVPN deployment requires absolute source/destination paths")
endif()
find_program(_patchelf patchelf REQUIRED)
file(REAL_PATH "${OPENVPN_SOURCE}" _source_real)
file(REAL_PATH "${OPENVPN_DESTINATION}/openvpn" _destination_real)
if(_source_real STREQUAL _destination_real)
    message(FATAL_ERROR "OpenVPN deployment must not modify its source")
endif()
get_filename_component(_source_directory "${OPENVPN_SOURCE}" DIRECTORY)
set(_source_manifest "${_source_directory}/openvpn-runtime-source.json")
if(EXISTS "${_source_manifest}")
    # New recipe packages carry their exact libraries. This remains valid when
    # the producer's absolute Conan cache/RPATH is no longer present.
    file(READ "${_source_manifest}" _source_metadata)
    string(JSON _expected_source GET "${_source_metadata}" source_sha256)
    file(SHA256 "${OPENVPN_SOURCE}" _actual_source)
    if(NOT _actual_source STREQUAL _expected_source)
        message(FATAL_ERROR "Packaged OpenVPN executable checksum mismatch")
    endif()
    string(JSON _count LENGTH "${_source_metadata}" libraries)
    set(_dependencies)
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _name MEMBER "${_source_metadata}" libraries ${_index})
            if(NOT _name MATCHES "^[A-Za-z0-9_.+-]+$")
                message(FATAL_ERROR "Invalid packaged dependency basename")
            endif()
            set(_library "${_source_directory}/openvpn-libs/${_name}")
            file(SHA256 "${_library}" _actual)
            string(JSON _expected GET "${_source_metadata}" libraries "${_name}")
            if(NOT _actual STREQUAL _expected)
                message(FATAL_ERROR "Packaged OpenVPN dependency checksum mismatch: ${_name}")
            endif()
            list(APPEND _dependencies "${_library}")
        endforeach()
    endif()
else()
    file(GET_RUNTIME_DEPENDENCIES
        EXECUTABLES "${OPENVPN_SOURCE}"
        RESOLVED_DEPENDENCIES_VAR _dependencies
        UNRESOLVED_DEPENDENCIES_VAR _unresolved
        CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
    if(_unresolved OR _conflicts_FILENAMES)
        message(FATAL_ERROR "Unresolved/conflicting native OpenVPN dependencies: ${_unresolved};${_conflicts_FILENAMES}")
    endif()
endif()
file(MAKE_DIRECTORY "${OPENVPN_DESTINATION}/openvpn-libs")
if(EXISTS "${OPENVPN_DESTINATION}/openvpn")
    file(CHMOD "${OPENVPN_DESTINATION}/openvpn" PERMISSIONS
        OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
file(COPY_FILE "${OPENVPN_SOURCE}" "${OPENVPN_DESTINATION}/openvpn" ONLY_IF_DIFFERENT)
file(CHMOD "${OPENVPN_DESTINATION}/openvpn" PERMISSIONS
    OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
set(_private_names)
set(_manifest "{\"libraries\":{}}")
foreach(_library IN LISTS _dependencies)
    # Host libc/loader and distribution libraries are not application packages.
    # Conan/private dependencies must never resolve through the service bundle.
    if(_library MATCHES "^/(usr/)?lib(64)?/")
        continue()
    endif()
    get_filename_component(_name "${_library}" NAME)
    if(_name IN_LIST _private_names)
        message(FATAL_ERROR "Ambiguous native OpenVPN dependency basename: ${_name}")
    endif()
    list(APPEND _private_names "${_name}")
    file(SHA256 "${_library}" _before)
    file(COPY_FILE "${_library}" "${OPENVPN_DESTINATION}/openvpn-libs/${_name}" ONLY_IF_DIFFERENT)
    file(SHA256 "${OPENVPN_DESTINATION}/openvpn-libs/${_name}" _after)
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Native OpenVPN library bytes changed: ${_name}")
    endif()
    string(JSON _manifest SET "${_manifest}" libraries "${_name}" "\"${_before}\"")
endforeach()
execute_process(COMMAND "${_patchelf}" --force-rpath --set-rpath "$ORIGIN/openvpn-libs"
    "${OPENVPN_DESTINATION}/openvpn" COMMAND_ERROR_IS_FATAL ANY)
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${OPENVPN_DESTINATION}/openvpn"
    RESOLVED_DEPENDENCIES_VAR _installed
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    CONFLICTING_DEPENDENCIES_PREFIX _installed_conflicts)
if(_unresolved OR _installed_conflicts_FILENAMES)
    message(FATAL_ERROR "Installed OpenVPN dependency resolution failed")
endif()
foreach(_name IN LISTS _private_names)
    set(_found FALSE)
    foreach(_library IN LISTS _installed)
        get_filename_component(_resolved_name "${_library}" NAME)
        if(_resolved_name STREQUAL _name)
            file(REAL_PATH "${_library}" _actual)
            file(REAL_PATH "${OPENVPN_DESTINATION}/openvpn-libs/${_name}" _expected)
            if(NOT _actual STREQUAL _expected)
                message(FATAL_ERROR "Installed OpenVPN selected a foreign library: ${_name}: ${_actual}")
            endif()
            set(_found TRUE)
        endif()
    endforeach()
    if(NOT _found)
        message(FATAL_ERROR "Installed OpenVPN lost native dependency: ${_name}")
    endif()
endforeach()
foreach(_library IN LISTS _installed)
    get_filename_component(_name "${_library}" NAME)
    if(NOT _library MATCHES "^/(usr/)?lib(64)?/" AND NOT _name IN_LIST _private_names)
        message(FATAL_ERROR "Installed OpenVPN gained an unexpected private dependency: ${_library}")
    endif()
endforeach()
file(SHA256 "${OPENVPN_SOURCE}" _source_hash)
file(SHA256 "${OPENVPN_DESTINATION}/openvpn" _deployed_hash)
string(JSON _manifest SET "${_manifest}" source_sha256 "\"${_source_hash}\"")
string(JSON _manifest SET "${_manifest}" deployed_sha256 "\"${_deployed_hash}\"")
file(WRITE "${OPENVPN_DESTINATION}/openvpn-runtime.json" "${_manifest}\n")
file(CHMOD "${OPENVPN_DESTINATION}/openvpn" PERMISSIONS
    OWNER_READ OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
