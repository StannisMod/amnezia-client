# Build the application server image first; add only independent client/test tools.
ARG IPSEC_SERVER_IMAGE=amnezia-ipsec-server-under-test:local
FROM ${IPSEC_SERVER_IMAGE}
RUN apk add --no-cache python3 util-linux strongswan
COPY server/ipv6/lab/test_ipsec.py /app/test_ipsec.py
COPY server/ipv6/lab/run_ipsec.sh /app/run_ipsec.sh
COPY client/server_scripts/ipsec/configure_container.sh /src/client/server_scripts/ipsec/configure_container.sh
COPY client/server_scripts/ipsec/enable_ipv6.sh /src/client/server_scripts/ipsec/enable_ipv6.sh
COPY client/server_scripts/ipsec/start.sh /src/client/server_scripts/ipsec/start.sh
ENTRYPOINT ["dumb-init", "tail", "-f", "/dev/null"]
CMD []
