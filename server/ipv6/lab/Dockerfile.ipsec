# Diagnostic interoperability environment, not a replacement production image.
# Keep the server's upstream entrypoint from generating fresh VPN identities.
FROM hwdsl2/ipsec-vpn-server@sha256:9ae4084cf5c93bced92551fbfffa5872291e21c84e6b1c2b46ab69eea5bacab1
RUN apk add --no-cache dumb-init python3 util-linux strongswan
ENTRYPOINT ["dumb-init", "tail", "-f", "/dev/null"]
CMD []
