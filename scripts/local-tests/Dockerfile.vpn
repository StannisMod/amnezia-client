FROM amneziavpn/amneziawg-go@sha256:cbafc02b8373a83f428272db6d8001b37bc02e6211cbd8c0cb4e2e3759b12b72 AS awg
FROM docker:29-dind
ARG TARGETARCH
RUN --mount=type=cache,id=amnezia-dind-apk-${TARGETARCH},target=/var/cache/apk,sharing=locked \
    apk --cache-dir /var/cache/apk add --update-cache python3 openssl openssh-client openssh-server sudo util-linux diffutils coreutils wireguard-tools
ENV PYTHONDONTWRITEBYTECODE=1
COPY --from=awg /usr/bin/awg /usr/bin/amneziawg-go /usr/bin/awg-quick /usr/bin/
