ARG QT_BASE_IMAGE=amnezia-local-qt-tests-ubuntu22
FROM golang:1.27.1 AS go
FROM ${QT_BASE_IMAGE}
COPY --from=go /usr/local/go /usr/local/go
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-venv libsecret-1-dev libxkbcommon-x11-0 pkg-config \
    autoconf automake libtool bison flex curl patchelf ccache \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/build-tools
ENV PATH=/opt/build-tools/bin:/usr/local/go/bin:/opt/Qt/6.10.1/gcc_64/bin:$PATH
RUN pip install --no-cache-dir cmake==3.31.6 conan==2.28.0 aqtinstall==3.3.0
RUN aqt install-qt linux desktop 6.10.1 linux_gcc_64 \
    -m qtremoteobjects qt5compat qtshadertools qthttpserver qtwebsockets -O /opt/Qt
ENV CMAKE_PREFIX_PATH=/opt/Qt/6.10.1/gcc_64
# Qt's SDK needs desktop OpenGL headers; Jammy's minimal Qt development
# packages do not pull them in with --no-install-recommends.
RUN apt-get update && apt-get install -y --no-install-recommends libgl1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
